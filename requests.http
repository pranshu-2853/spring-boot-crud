@host = http://localhost:8080
@userToken = REPLACE_WITH_USER_TOKEN
@adminToken = REPLACE_WITH_ADMIN_TOKEN

############################################################
###################### PUBLIC ENDPOINTS ####################
############################################################

### OpenAPI docs should be public (200)
GET {{host}}/v3/api-docs

### Register USER (200 or 409 if already exists)
POST {{host}}/auth/register
Content-Type: application/json

{
  "username": "user_test",
  "password": "1234",
  "role": "ROLE_USER"
}

### Register ADMIN (200 or 409 if already exists)
POST {{host}}/auth/register
Content-Type: application/json

{
  "username": "admin_test",
  "password": "1234",
  "role": "ROLE_ADMIN"
}

### Login USER (200, copy token into @userToken)
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "user_test",
  "password": "1234"
}

### Login ADMIN (200, copy token into @adminToken)
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "admin_test",
  "password": "1234"
}


############################################################
##################### AUTHZ BEHAVIOR #######################
############################################################

### No token -> 401
GET {{host}}/api/v1/software-engineer

### USER can GET -> 200
GET {{host}}/api/v1/software-engineer
Authorization: Bearer <token>

### USER cannot POST -> 403
POST {{host}}/api/v1/software-engineer
Authorization: Bearer <token>
Content-Type: application/json

{
  "name": "User Attempt",
  "techStack": "Java"
}

### ADMIN can POST -> 201
POST {{host}}/api/v1/software-engineer
Authorization: Bearer <token>
Content-Type: application/json

{
  "name": "Admin Success1",
  "techStack": "Spring Boot11"
}


############################################################
##################### PROTECTED CRUD #######################
############################################################

### Get all engineers with admin token
GET {{host}}/api/v1/software-engineer
Authorization: Bearer <token>

### Get by id (change id as needed)
GET {{host}}/api/v1/software-engineer/4
Authorization: Bearer <token>

### Update engineer by id (ADMIN only)
PUT {{host}}/api/v1/software-engineer/4
Authorization: Bearer <token>
Content-Type: application/json

{
  "name": "Updated Name",
  "techStack": "Java, Spring Boot, Docker"
}

### Delete engineer by id (ADMIN only)
DELETE {{host}}/api/v1/software-engineer/4
Authorization: Bearer <token>


############################################################
############### PAGINATION + FILTER + SORT #################
############################################################

### Pagination default sort(id,asc)
GET {{host}}/api/v1/software-engineer?page=0&size=5
Authorization: Bearer <token>

### Explicit sort asc
GET {{host}}/api/v1/software-engineer?page=0&size=5&sort=id,asc
Authorization: Bearer <token>

### Explicit sort desc
GET {{host}}/api/v1/software-engineer?page=0&size=5&sort=id,desc
Authorization: Bearer <token>

### Filter by name
GET {{host}}/api/v1/software-engineer?name=an
Authorization: Bearer <token>

### Filter by tech stack
GET {{host}}/api/v1/software-engineer?techStack=java
Authorization: Bearer <token>

### Combined filters
GET {{host}}/api/v1/software-engineer?name=an&techStack=java
Authorization: Bearer <token>